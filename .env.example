# Salin ke .env lalu isi nilainya. Jangan commit .env.
# Isi key yang sama di Vercel (Project Settings > Environment Variables).

# Neon Postgres: connection string pooled dari Neon Console
DATABASE_URL=
# Connection string langsung (non-pooled) dari Neon, dipakai `prisma migrate`.
# WAJIB juga diisi di Vercel: prisma.config.ts membacanya saat `prisma generate` (postinstall), tanpa ini build gagal.
DIRECT_URL=

# Better Auth: BETTER_AUTH_SECRET dibuat dengan `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# http://localhost:3000 di lokal; di Vercel isi alamat produksi, mis. https://namaproyek.vercel.app (tanpa garis miring di akhir)
BETTER_AUTH_URL=http://localhost:3000

# Cloudinary (Dashboard > API Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Sama dengan CLOUDINARY_CLOUD_NAME; terkirim ke browser, jangan beri secret prefix NEXT_PUBLIC_
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Backup Google Drive: OAuth 2.0 akun pribadi (bukan service account), scope drive.file.
# Ubah status OAuth app ke "In production" agar refresh token tidak kedaluwarsa 7 hari.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=

# Token acak panjang; Vercel Cron mengirimnya sebagai "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=

# Opsional: untuk skrip seed akun admin pertama (tidak ada pendaftaran publik)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# OCR tulisan tangan lewat Gemini API. Key dibuat di aistudio.google.com (Get API key); dipakai hanya di server.
GEMINI_API_KEY=
# Model vision; ganti ke gemini-3.6-flash bila tulisan terlalu sulit dibaca
GEMINI_MODEL=gemini-3.5-flash-lite
# Batas pembacaan OCR per hari untuk seluruh aplikasi, menjaga kuota gratis
OCR_DAILY_LIMIT=50
